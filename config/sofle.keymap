        };

        SignUp: SignUp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp I &kp G &kp N &kp SPACE &kp LS(U) &kp P>;
        };

        Event: Event {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(E) &kp V &kp E &kp N &kp T>;
        };

        Form: Form {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
